  "info": {
    "title": "AdOnTheGo API",
    "description": "AdOnTheGo Backend APIs",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "player-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Enter: ApiKey <your-api-key>"
      }
    },
    "schemas": {
      "CreateAdvertiserDto": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "example": "AdOnTheGo"
          },
          "contactName": {
            "type": "string",
            "example": "Hemil Kothari"
          }
        },
        "required": [
          "companyName",
          "contactName"
        ]
      },
      "UpdateAdvertiserDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCampaignDto": {
        "type": "object",
        "properties": {
          "campaignName": {
            "type": "string",
            "example": "ABC Campaign"
          },
          "advertiserId": {
            "type": "string",
            "example": "adv_123456"
          },
          "durationDays": {
            "type": "number",
            "example": 30
          },
          "frequencyPerLoop": {
            "type": "number",
            "example": 5
          },
          "fleetSize": {
            "type": "number",
            "example": 1000
          },
          "mediaAssetId": {
            "type": "string",
            "description": "Uploaded Media Asset ID"
          },
          "creativeChangesAllowed": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "campaignName",
          "advertiserId",
          "durationDays",
          "frequencyPerLoop",
          "fleetSize",
          "mediaAssetId",
          "creativeChangesAllowed"
        ]
      },
      "UpdateCreativeDto": {
        "type": "object",
        "properties": {}
      },
      "ModifyCampaignDto": {
        "type": "object",
        "properties": {}
      },
      "CreateDeviceDto": {
        "type": "object",
        "properties": {
          "serialNumber": {
            "type": "string",
            "example": "HW-SN-123456"
          },
          "simNumber": {
            "type": "string",
            "example": "919876543210"
          }
        }
      },
      "UpdateDeviceDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateDriverActivityDto": {
        "type": "object",
        "properties": {}
      },
      "CreateDriverDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateDriverDto": {
        "type": "object",
        "properties": {}
      },
      "CreateRickshawDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateRickshawDto": {
        "type": "object",
        "properties": {}
      },
      "CreateDeviceProvisionDto": {
        "type": "object",
        "properties": {}
      },
      "CreateDriverDocumentDto": {
        "type": "object",
        "properties": {
          "documentType": {
            "type": "string",
            "example": "PUC",
            "enum": [
              "AADHAAR_FRONT",
              "AADHAAR_BACK",
              "PAN_CARD",
              "LICENCE_FRONT",
              "LICENCE_BACK",
              "RC_BOOK",
              "INSURANCE",
              "PUC",
              "PERMIT"
            ]
          },
          "fileUrl": {
            "type": "string",
            "example": "puc.pdf"
          },
          "expiryDate": {
            "type": "string",
            "example": "2027-06-26"
          }
        },
        "required": [
          "documentType",
          "fileUrl"
        ]
      },
      "VerifyDriverDocumentDto": {
        "type": "object",
        "properties": {}
      },
